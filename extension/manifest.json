{
    "manifest_version": 3,
    "name": "GitHub diff filters",
    "version": "1.21.2",
    "description": "Hides test files, lockfiles, generated code and comment-only lines on GitHub pull request diffs, automatically.",
    "minimum_chrome_version": "111",
    "content_scripts": [
        {
            "matches": [
                "https://github.com/*"
            ],
            "js": [
                "bridge.js"
            ],
            "run_at": "document_start",
            "world": "ISOLATED",
            "all_frames": false
        },
        {
            "matches": [
                "https://github.com/*"
            ],
            "js": [
                "filters/hide-comment-diffs.js",
                "filters/hide-test-files.js",
                "bootstrap.js",
                "controls.js"
            ],
            "run_at": "document_idle",
            "world": "MAIN",
            "all_frames": false
        }
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "permissions": [
        "storage"
    ]
}
